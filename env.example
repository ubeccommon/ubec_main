# ============================================================================
# UBEC Protocol - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# ============================================================================
# STELLAR NETWORK CONFIGURATION
# ============================================================================

# Network selection: 'testnet' or 'mainnet'
UBEC_NETWORK=mainnet

# ============================================================================
# TOKEN ISSUER ADDRESSES
# ============================================================================
# IMPORTANT: Replace these with your actual Stellar issuer addresses

# Air Element (UBEC) - Gateway Token
UBEC_ISSUER=GDPNB7S3IOM2J6C3NA2QG4TQAUCRZXPJJ4HSCSIKELEH7ORUCX5UB2VN

# Water Element (UBECrc) - Flow Token
UBECrc_ISSUER=GBYOTGM27KLFNQQU3G6QWVEK7LQB36N6OX2YLYMN4WU3AFM4VRFZUBEC

# Earth Element (UBECgpi) - Stability Token
UBECgpi_ISSUER=GCPU3LUGRIYLWMPOQEEGIL2HI5Z637PQVK42Z5PYRRQMPFDTNT5SUBEC

# Fire Element (UBECtt) - Transformation Token
UBECtt_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database connection
UBEC_DB_HOST=localhost
UBEC_DB_PORT=5432
UBEC_DB_NAME=ubec
UBEC_DB_SCHEMA=ubec_main

# Application User (main protocol operations)
UBEC_DB_USER=ubec_app
UBEC_DB_PASSWORD=YourSecureAppP@ssw0rd!2025

# Read-Only User (reporting and analytics)
UBEC_DB_READONLY_USER=ubec_readonly
UBEC_DB_READONLY_PASSWORD=YourSecureRe@dP@ssw0rd!2025

# Sync User (blockchain synchronization)
UBEC_DB_SYNC_USER=ubec_sync
UBEC_DB_SYNC_PASSWORD=YourSecureSyncP@ssw0rd!2025

# Connection Pool Settings
UBEC_DB_POOL_MIN=2
UBEC_DB_POOL_MAX=20
UBEC_DB_POOL_TIMEOUT=30

# SSL Mode: disable, allow, prefer, require, verify-ca, verify-full
UBEC_DB_SSL_MODE=prefer

# ============================================================================
# SYNCHRONIZATION CONFIGURATION
# ============================================================================

# Sync intervals (in seconds)
SYNC_INTERVAL_ACCOUNTS=300      # 5 minutes
SYNC_INTERVAL_TRANSACTIONS=60   # 1 minute
SYNC_INTERVAL_BALANCES=180      # 3 minutes

# Sync batch size
SYNC_BATCH_SIZE=200

# Retry configuration
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=5

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=false

# Log file path (if LOG_TO_FILE=true)
LOG_FILE_PATH=logs/ubec_protocol.log

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================================================
# DEVELOPMENT VS PRODUCTION
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (more verbose logging)
DEBUG=false

# ============================================================================
# NOTES
# ============================================================================
# 
# After copying this file to .env:
# 1. Update all XXXXX placeholder values with real addresses
# 2. Set secure passwords for all database users
# 3. Adjust sync intervals based on your needs
# 4. Enable file logging for production (LOG_TO_FILE=true)
# 5. Set appropriate log levels for your environment
# 
# Security reminders:
# - Never commit .env to version control
# - Rotate passwords regularly
# - Use SSL for production database connections
# - Restrict file permissions: chmod 600 .env
# ============================================================================
