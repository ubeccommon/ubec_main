# ==================== DATABASE CONFIGURATION ====================

# Database Host
DB_HOST=localhost

# Database Port
DB_PORT=5432

# Database Name
DB_NAME=ubec

# Database Schema
#DB_SCHEMA=ubec_main, phenomenal, topology, public

DB_SEARCH_PATH=ubec_main, phenomenal, topology, public

# Database User (application user with read/write permissions)
DB_USER=ubec_app

# Database Password (REQUIRED - set your secure password)
DB_PASSWORD=.................

# Read-only User (optional - for reporting/analytics)
DB_READONLY_USER=ubec_readonly
DB_READONLY_PASSWORD=.....................

# Sync User (optional - for data synchronization)
DB_SYNC_USER=ubec_sync
DB_SYNC_PASSWORD=..................


# ==================== STELLAR CONFIGURATION ====================

# Network Passphrase (auto-selected based on UBEC_NETWORK)
# Public Global Stellar Network ; September 2015  (mainnet)
# Test SDF Network ; September 2015              (testnet)


# ==================== OPERATION LIMITS ====================
# NEW in v5.4: Configurable limits for sync and discover operations

# Maximum accounts to sync per asset in sync mode (default: 5000)
# Set to 0 in CLI (--limit 0) for unlimited sync
SYNC_LIMIT=5000

# Maximum accounts to discover per asset in discover mode (default: 1000)
DISCOVER_LIMIT=1000

# Transaction limit per account (default: 100)
# TRANSACTION_LIMIT=100


# ==================== RATE LIMITING ====================

# API rate limit (requests per second)
RATE_LIMIT=10.0


# ==================== CACHE CONFIGURATION ====================

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# Analytics cache TTL in seconds (default: 300 = 5 minutes)
ANALYTICS_CACHE_TTL=300


# ==================== LOGGING ====================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file location (optional)
LOG_FILE=ubec_main_$(date +%Y%m%d_%H%M%S).log


# ==================== HOLONIC EVALUATION ====================

# Holonic principle weights (sum should equal 1.0)
HOLONIC_WEIGHT_AUTONOMY=0.25
HOLONIC_WEIGHT_MULTISCALE=0.20
HOLONIC_WEIGHT_EMERGENCE=0.20
HOLONIC_WEIGHT_FEEDBACK=0.20
HOLONIC_WEIGHT_RESILIENCE=0.15


# ==================== DEVELOPMENT / DEBUG ====================

# Enable debug mode (more verbose logging)
# DEBUG=false

# Enable dry run mode (no database writes)
# DRY_RUN=false

# Enable profiling (performance analysis)
# ENABLE_PROFILING=false


# ==================== NOTES ====================
#
# SYNC_LIMIT and DISCOVER_LIMIT (NEW in v5.4):
# -----------------------------------------------
# These control how many accounts are processed in sync and discover operations.
# 
# - Defaults are conservative to respect Stellar API rate limits
# - SYNC_LIMIT=5000 means sync up to 5000 accounts per asset
# - DISCOVER_LIMIT=1000 means discover up to 1000 new accounts per asset
# - Can be overridden via CLI: python main.py --mode sync --limit 10000
# - Use --limit 0 for unlimited sync (BE CAREFUL with rate limits!)
#
# Rate Limiting:
# --------------
# - Stellar Horizon has rate limits: 3600 requests/hour per IP
# - The synchronizer implements automatic rate limit detection and backoff
# - If you hit rate limits, the system will automatically pause and resume
# - For large syncs, consider running during off-peak hours
# 
# Security:
# ---------
# - NEVER commit this file with real passwords to git
# - Use strong, unique passwords for database access
# - Restrict database user permissions to minimum required
# - Consider using secrets management in production
#
