# UBEC Protocol - Environment Configuration
# ==========================================
# 
# This file supports BOTH legacy and new variable naming conventions.
# The connection.py module will use the following priority:
#   1. New variables (UBEC_DB_*)
#   2. Legacy variables (DB_*)
#   3. Default values
#
# You can use either naming convention, or both during migration.

# ============================================================================
# RECOMMENDED: Use New Variables (for main.py and future modules)
# ============================================================================

# Database Configuration (New)
UBEC_DB_HOST=localhost
UBEC_DB_PORT=5432
UBEC_DB_NAME=ubec
UBEC_DB_USER=ubec_app
UBEC_DB_PASSWORD=your_password_here
UBEC_DB_SCHEMA=ubec_main

# Stellar Network Configuration (New)
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Token Issuer Addresses (New)
UBEC_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
UBECRC_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
UBECGPI_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
UBECTT_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Operational Parameters (New)
UBEC_RATE_LIMIT=10.0
UBEC_MAX_ACCOUNTS=1000
UBEC_SYNC_DAYS=7
UBEC_MONITOR_INTERVAL=300


# ============================================================================
# LEGACY: Old Variables (for compatibility with existing modules)
# ============================================================================
# 
# These are used by:
# - core/holonic/UBECHolonicEvaluator
# - core/db/UBECDataSynchronizer
# - core/audit/ubec_token_audit
#
# If you don't set UBEC_DB_* variables above, these will be used as fallback.
# You can use the same values as the new variables, or different ones
# if you're running two separate database systems during migration.

# Database Configuration (Legacy)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubec_recipro
DB_USER=recipro
DB_PASSWORD=your_password_here
DB_SCHEMA=ubec_recipro

# Stellar Network Configuration (Legacy)
NETWORK=PUBLIC
HORIZON_URL=https://horizon.stellar.org
PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Token Configuration (Legacy)
UBEC_CODE=UBEC
# UBEC_ISSUER already defined above


# ============================================================================
# MIGRATION SCENARIOS
# ============================================================================

# Scenario 1: Using ONE database with DIFFERENT users
# ----------------------------------------------------
# Good for gradual migration - both systems access same database but with
# different users that may have different permissions.
#
# UBEC_DB_NAME=ubec              # New system database
# UBEC_DB_USER=ubec_app           # New user
# UBEC_DB_PASSWORD=newpass
# 
# DB_NAME=ubec                    # Same database
# DB_USER=recipro                 # Old user  
# DB_PASSWORD=oldpass
#
# Make sure both users exist in PostgreSQL and have appropriate permissions.


# Scenario 2: Using ONE database with SAME user
# ----------------------------------------------
# Simplest - both systems use the same database and same credentials.
#
# UBEC_DB_NAME=ubec
# UBEC_DB_USER=ubec_app
# UBEC_DB_PASSWORD=my_password
# 
# DB_NAME=ubec                    # Same values
# DB_USER=ubec_app                 # Same user
# DB_PASSWORD=my_password          # Same password


# Scenario 3: Using TWO separate databases
# -----------------------------------------
# For testing - run old system on one database and new on another.
#
# UBEC_DB_NAME=ubec               # New database
# UBEC_DB_USER=ubec_app
# UBEC_DB_PASSWORD=newpass
# 
# DB_NAME=ubec_recipro            # Legacy database
# DB_USER=recipro
# DB_PASSWORD=oldpass


# Scenario 4: Only using legacy variables
# ----------------------------------------
# If you only set DB_* variables, the new system will use them via fallback.
# Just leave UBEC_DB_* variables commented out or removed.
#
# DB_NAME=ubec_recipro
# DB_USER=recipro
# DB_PASSWORD=my_password
# 
# (Don't set UBEC_DB_* variables)


# ============================================================================
# QUICK START - RECOMMENDED SETUP
# ============================================================================
# 
# For a new installation, use this minimal configuration:

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and set these required values:
#    UBEC_DB_PASSWORD=your_actual_password
#    DB_PASSWORD=your_actual_password  (use same password)
#    UBEC_ISSUER=your_actual_issuer_address
#    UBECRC_ISSUER=your_actual_issuer_address
#    UBECGPI_ISSUER=your_actual_issuer_address
#    UBECTT_ISSUER=your_actual_issuer_address
#
# 3. Create the database user if needed:
#    sudo -u postgres psql
#    CREATE USER ubec_app WITH PASSWORD 'your_password';
#    CREATE DATABASE ubec OWNER ubec_app;
#    GRANT ALL PRIVILEGES ON DATABASE ubec TO ubec_app;
#    \q
#
# 4. Test the connection:
#    python main.py --mode health


# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit this file to git with real passwords
# 2. Add .env to your .gitignore file
# 3. Use strong passwords (at least 16 characters)
# 4. Rotate passwords every 90 days
# 5. Use different passwords for different environments (dev/staging/prod)
# 6. Consider using a secrets manager for production (e.g., AWS Secrets Manager)


# ============================================================================
# TESTING YOUR CONFIGURATION
# ============================================================================
#
# Test database connection:
#   python -c "from db.connection import get_connection; conn = get_connection(); print('✓ Connected'); conn.close()"
#
# Test with new variables:
#   python -c "import os; os.environ['UBEC_DB_USER']='ubec_app'; from db.connection import get_connection; print('✓ OK')"
#
# Test with legacy variables:
#   python -c "import os; os.environ['DB_USER']='recipro'; from db.connection import get_connection; print('✓ OK')"
#
# Test main.py health check:
#   python main.py --mode health


# ============================================================================
# VARIABLE REFERENCE
# ============================================================================
#
# Priority for each setting:
#
# Host:     UBEC_DB_HOST → DB_HOST → 'localhost'
# Port:     UBEC_DB_PORT → DB_PORT → '5432'
# Database: UBEC_DB_NAME → DB_NAME → 'ubec_recipro'
# User:     UBEC_DB_USER → DB_USER → 'recipro'
# Password: UBEC_DB_PASSWORD → DB_PASSWORD → 'password'
# Schema:   UBEC_DB_SCHEMA → DB_SCHEMA → 'ubec_main'
#
# This means:
# - If UBEC_DB_USER is set, it will be used
# - If UBEC_DB_USER is not set, DB_USER will be used
# - If neither is set, 'recipro' will be used


