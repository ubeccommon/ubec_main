# UBEC Distribution Service - Environment Variables
# ===============================================================================
# 
# CRITICAL SECURITY WARNING:
# - NEVER commit this file with actual secret keys to version control
# - Copy this file to .env and fill in your actual secret keys
# - Add .env to .gitignore
# - Use different keys for TESTNET vs MAINNET
# - Rotate keys regularly
# - Restrict access to this file (chmod 600 .env)
#
# ===============================================================================

# ===============================================================================
# STELLAR NETWORK CONFIGURATION
# ===============================================================================

# Network: TESTNET or MAINNET (always test on TESTNET first!)
UBEC_NETWORK=TESTNET

# ===============================================================================
# ACCOUNT SECRET KEYS
# ===============================================================================
# Format: Stellar secret keys always start with 'S' and are 56 characters long
# Example: SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
# How to get your secret keys:
# 1. TESTNET: Generate test keys at https://laboratory.stellar.org/#account-creator
# 2. MAINNET: NEVER share your mainnet keys. Use secure key generation.
#
# ===============================================================================

# General Distribution Account
# Public Address: GDC2ECKYO4WJMD35M4E2JIABPTA4VLHC6L6MU4TIRCLSOPOOIYOYTM74
UBEC_GENERAL_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Administration Account  
# Public Address: GDEQ4KXOL6NV5RGETFTJLMULACO5M5GTYBKOEGTCN2MSSJCOAID5UBEC
UBEC_ADMIN_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stewardship Management Account
# Public Address: GA3I6MN4NSUKZ2NQZBWLUP6MNMPLZFD3ABOA3CMBV23NBDBFRWRUUBEC
UBEC_STEWARDSHIP_MANAGEMENT_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stewardship Infrastructure Account
# Public Address: GCBT4HZHOXJCCVDQDJHA7KR6IN3RANWBPK3DKCSUPN2R4BMCGBZYUBEC
UBEC_STEWARDSHIP_INFRASTRUCTURE_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stewardship Liquidity Account
# Public Address: GCFJCAHHHDI5XNK3CABHPN565DIPAXP2MPQXCQVYV7IDYQLA6G4JUBEC
UBEC_STEWARDSHIP_LIQUIDITY_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ===============================================================================
# DATABASE CONFIGURATION (Optional - for transaction recording)
# ===============================================================================

# Database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/ubec

# Database schema
# DB_SCHEMA=ubec_main

# ===============================================================================
# SAFETY LIMITS (Optional - Recommended for production)
# ===============================================================================

# Maximum transfer amount per transaction (in UBEC)
# MAX_TRANSFER_AMOUNT=1000000

# Daily transfer limit (in UBEC)  
# DAILY_TRANSFER_LIMIT=10000000

# Require manual confirmation for amounts above (in UBEC)
# CONFIRMATION_THRESHOLD=100000

# ===============================================================================
# RATE LIMITING (Optional)
# ===============================================================================

# Maximum Stellar API calls per second
# STELLAR_RATE_LIMIT=5

# ===============================================================================
# MONITORING AND ALERTING (Optional)
# ===============================================================================

# Slack webhook for alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email for critical alerts
# ALERT_EMAIL=admin@yourdomain.com

# ===============================================================================
# SETUP INSTRUCTIONS
# ===============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your actual secret keys:
#    nano .env  (or your preferred editor)
#
# 3. Secure the file:
#    chmod 600 .env
#
# 4. Add to .gitignore:
#    echo ".env" >> .gitignore
#
# 5. Load in your application:
#    In Python: from dotenv import load_dotenv; load_dotenv()
#
# 6. Test on TESTNET first:
#    Ensure UBEC_NETWORK=TESTNET
#    Run: python main.py --mode distribution --action rebalance --dry-run
#
# 7. Only after thorough testing, switch to MAINNET:
#    Change UBEC_NETWORK=MAINNET
#    Use different secret keys for mainnet
#
# ===============================================================================
# SECURITY CHECKLIST
# ===============================================================================
#
# [ ] .env file has chmod 600 permissions
# [ ] .env is in .gitignore
# [ ] Using different keys for TESTNET vs MAINNET
# [ ] Tested thoroughly on TESTNET before using MAINNET
# [ ] Secret keys stored securely (not in chat logs, emails, etc.)
# [ ] Only authorized team members have access to secret keys
# [ ] Keys will be rotated regularly
# [ ] Monitoring and alerts configured
# [ ] Backup and recovery procedures documented
#
# ===============================================================================
