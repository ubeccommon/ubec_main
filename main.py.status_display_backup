def create_response(success: bool, data: Dict[str, Any] = None, error: str = None) -> Dict[str, Any]:
    """Create standardized response"""
    response = {
        'success': success,
        'timestamp': datetime.now().isoformat()
    }
    if data:
        response.update(data)
    if error:
        response['error'] = error
    return response


