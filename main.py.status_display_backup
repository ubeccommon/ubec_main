    health = await registry.health_check(detailed=True)
    
    # Add summary with pattern information
    patterns_used = {
        'api_dependent': ['air', 'water', 'earth', 'fire', 'orderbook'],
        'database_only': ['holonic_evaluator'],
        'service_dependent': ['distribution_evaluator']
    }
    
    health['health_check_patterns'] = patterns_used
    health['message'] = f"System health: {health['overall_status']}"
    health['summary_text'] = (
        f"{health['summary']['healthy']}/{health['summary']['total']} services healthy"
    )
    
    return health


