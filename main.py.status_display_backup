async def run_health_check() -> Dict[str, Any]:
    """
    Perform comprehensive system health check using registry.
    
    All services now use standardized ServiceHealthCheck utility:
    - api_dependent_health() for protocols and orderbook
    - database_only_health() for holonic evaluator
    - database_dependent_health() for distribution evaluator
