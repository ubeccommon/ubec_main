# audit/ubec_token_audit.py

import os
import sys
import time
import logging
import json
import argparse
from datetime import datetime, timedelta
from decimal import Decimal, getcontext
from pathlib import Path
import requests
from dotenv import load_dotenv
from stellar_sdk import Server, Asset

# Import the database connection module
from db.connection import DatabaseManager

# Import holonic evaluation modules if available
try:
    from holonic.ubec_holonic_evaluator import UBECHolonicEvaluator
    HOLONIC_AVAILABLE = True
except ImportError:
    HOLONIC_AVAILABLE = False
    logging.warning("Holonic evaluation module not available - holonic metrics will be skipped")

# Configure precision for decimal calculations
getcontext().prec = 10

# Setup logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler("ubec_audit.log"),
        logging.StreamHandler()
    ]
)

class UBECTokenAudit:
    """
    Audit module for UBEC token distribution and supply.
    This module provides detailed analysis and reporting on UBEC token distribution
    across all accounts, including tokenomics compliance verification and holonic metrics.
    
    This refactored version uses PostgreSQL database for persistence while maintaining
    compatibility with direct Stellar network queries when needed.
    
    UBEC Tokenomics:
    - Target Distribution:
        - Stewardship (30%)
        - Administration (5%)
        - General Distribution: Remaining tokens to be distributed as needed
    
    Accounts:
    - General Distribution: GDC2ECKYO4WJMD35M4E2JIABPTA4VLHC6L6MU4TIRCLSOPOOIYOYTM74
    - Stewardship Management: GA3I6MN4NSUKZ2NQZBWLUP6MNMPLZFD3ABOA3CMBV23NBDBFRWRUUBEC
    - Infrastructure & Stakeholder: GCBT4HZHOXJCCVDQDJHA7KR6IN3RANWBPK3DKCSUPN2R4BMCGBZYUBEC
    - Liquidity Pool: GCFJCAHHHDI5XNK3CABHPN565DIPAXP2MPQXCQVYV7IDYQLA6G4JUBEC
    - Administration: GDEQ4KXOL6NV5RGETFTJLMULACO5M5GTYBKOEGTCN2MSSJCOAID5UBEC
    """
    
    def __init__(self, config_path="../config/settings.py", data_source="hybrid", include_holonic=True):
        """
        Initialize the audit module using settings from the provided config file.
        
        Args:
            config_path: Path to the settings file
            data_source: Source of data - "db" (database only), "stellar" (Stellar API only), 
                         or "hybrid" (try database first, fall back to Stellar)
            include_holonic: Whether to include holonic evaluation metrics
        """
        logging.info(f"Initializing UBEC Token Audit module with config path: {config_path}")
        
        # Set data source preference
        self.data_source = data_source
        logging.info(f"Using {data_source} as data source")
        
        # Set holonic evaluation flag
        self.include_holonic = include_holonic and HOLONIC_AVAILABLE
        if self.include_holonic:
            logging.info("Holonic evaluation will be included in audit")
        else:
            logging.info("Holonic evaluation will be skipped")
        
        # Set default reports directory
        current_dir = os.path.dirname(os.path.abspath(__file__))
        self.default_reports_dir = os.path.join(os.path.dirname(current_dir), "reports")
        
        # Load environment variables
        load_dotenv()
        
        # Import settings
        try:
            # Get the absolute path of the config file
            config_dir = os.path.abspath(os.path.join(os.getcwd(), os.path.pardir))
            sys.path.append(config_dir)
            
            logging.info(f"Looking for config in: {config_dir}")
            
            # Try to import settings directly
            try:
                from config import settings
                self.settings = settings
                logging.info("Successfully imported settings from config package")
            except ImportError:
                # If that fails, try to load settings from the file path
                logging.info(f"Direct import failed, trying to load from {config_path}")
                
                if not os.path.exists(config_path):
                    # Try to look one directory up
                    parent_config_path = os.path.join(os.path.dirname(os.getcwd()), "config/settings.py")
                    if os.path.exists(parent_config_path):
                        config_path = parent_config_path
                        logging.info(f"Found settings file at: {config_path}")
                    else:
                        logging.error(f"Could not find settings file at {config_path} or {parent_config_path}")
                        raise ImportError(f"Settings file not found at {config_path} or {parent_config_path}")
                
                # Create a module spec and load the module
                import importlib.util
                spec = importlib.util.spec_from_file_location("settings", config_path)
                settings_module = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(settings_module)
                self.settings = settings_module
                logging.info(f"Successfully loaded settings from {config_path}")
        except Exception as e:
            logging.error(f"Error importing settings: {e}")
            raise
        
        # Initialize database connection
        if self.data_source != "stellar":
            try:
                self.db = DatabaseManager(schema='ubec_recipro')
                logging.info("Successfully connected to database")
            except Exception as e:
                logging.error(f"Error connecting to database: {e}")
                if self.data_source == "db":
                    raise
                else:
                    logging.warning("Falling back to Stellar API only due to database connection error")
                    self.data_source = "stellar"
        
        # Set up Stellar network connection (needed for both db and stellar modes)
        self.network = self.settings.PUBLIC_NETWORK_PASSPHRASE
        self.server = Server(horizon_url=self.settings.HORIZON_URL)
        
        # Set up UBEC asset
        self.ubec_issuer = self.settings.UBEC_ISSUER
        self.ubec_code = self.settings.UBEC_CODE
        self.ubec_asset = Asset(self.settings.UBEC_CODE, self.ubec_issuer)
        
        # Load account information
        self.accounts = self.settings.ACCOUNTS
        self.target_distribution = self.settings.TARGET_DISTRIBUTION
        
        # Generate unique report folder for this audit session
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        self.current_report_dir = os.path.join(self.default_reports_dir, f"audit_{timestamp}")
        
        # Initialize holonic evaluator if enabled
        self.holonic_evaluator = None
        if self.include_holonic:
            try:
                self.holonic_evaluator = UBECHolonicEvaluator(config_path=config_path, db_connection=self.db.connection if hasattr(self.db, 'connection') else None)
                logging.info("Successfully initialized Holonic Evaluator")
            except Exception as e:
                logging.error(f"Error initializing Holonic Evaluator: {e}")
                self.include_holonic = False
        
        # Verify that target distribution adds up to 1.0 (100%)
        target_sum = sum(Decimal(str(v)) for v in self.target_distribution.values())
        if abs(target_sum - Decimal('1.0')) > Decimal('0.001'):
            logging.warning(f"Target distribution does not add up to 100%: {target_sum*100:.2f}%")
            logging.warning(f"Target distribution values: {self.target_distribution}")
        
        # Get the total supply from the network or database
        self.total_supply = self.get_total_supply()
        
        # Initialize the audit report structure
        self.audit_report = {
            "timestamp": datetime.now().isoformat(),
            "total_supply": str(self.total_supply),  # Store as string to avoid precision issues
            "accounts": {},
            "distribution": {},
            "tokenomics_compliance": {},
            "untracked_supply": "0",
            "liquidity_pools": {},
            "target_values": {},  # Target values based on percentages of actual supply
            "holonic_metrics": {}  # Will be populated with holonic evaluation results if enabled
        }
        
        logging.info(f"UBEC Token Audit module initialized with total supply of {self.total_supply} UBEC")
        logging.info(f"Target distribution: Stewardship=30%, Administration=5%, General=remainder for distribution as needed")
    
    def get_total_supply(self):
        """
        Get the total supply of UBEC tokens from database only.

        Returns:
            Decimal: The total UBEC supply
        """
        logging.info("Calculating total UBEC supply...")

        try:
            # Always use database for total supply
            query = """
            SELECT total_supply 
            FROM asset_holder_analysis 
            WHERE asset_code = %s AND asset_issuer = %s 
            ORDER BY analysis_date DESC 
            LIMIT 1
            """
            result = self.db.execute_query(query, [self.ubec_code, self.ubec_issuer], fetch_one=True)

            if result and 'total_supply' in result:
                total_supply = Decimal(result['total_supply'])
                logging.info(f"Total UBEC supply from database: {total_supply}")
                return total_supply
            else:
                logging.error("No supply data found in database")
                # Return fallback value if no data
                if hasattr(self.settings, 'FALLBACK_SUPPLY'):
                    return self.settings.FALLBACK_SUPPLY
                return Decimal('191766039')

        except Exception as e:
            logging.error(f"Error calculating total supply from database: {e}")
            if hasattr(self.settings, 'FALLBACK_SUPPLY'):
                return self.settings.FALLBACK_SUPPLY
            return Decimal('191766039')
    
    def get_account_balance(self, account_address, include_lp=False):
        """
        Get the UBEC token balance for a specific account from database.
        
        Args:
            account_address: Stellar account address to check
            include_lp: Whether to include liquidity pool balances (default False to avoid double counting)
            
        Returns:
            Decimal: The UBEC balance of the account
        """
        try:
            # Get direct balance from database
            query = """
            SELECT balance 
            FROM asset_holders 
            WHERE account_id = %s AND asset_code = %s AND asset_issuer = %s
            """
            result = self.db.execute_query(query, [account_address, self.ubec_code, self.ubec_issuer], fetch_one=True)

            if result and 'balance' in result:
                direct_balance = Decimal(result['balance'])
            else:
                direct_balance = Decimal('0')
                logging.info(f"No balance found in database for {account_address}")
            
            # Only include LP balance if explicitly requested
            lp_balance = Decimal('0')
            if include_lp:
                try:
                    # Get LP ownership percentage for this account
                    lp_query = """
                    SELECT lpo.ownership_percentage, lp.balance
                    FROM ubec_recipro.liquidity_pool_owners lpo
                    JOIN ubec_recipro.liquidity_pools lp ON lpo.liquidity_pool_id = lp.id
                    WHERE lpo.account_id = %s
                    AND lp.asset_code = %s AND lp.asset_issuer = %s
                    """
                    lp_results = self.db.execute_query(lp_query, [account_address, self.ubec_code, self.ubec_issuer], fetch_all=True)

                    for lp in lp_results:
                        if lp:
                            lp_share = Decimal(lp['balance']) * (Decimal(lp['ownership_percentage']) / 100)
                            lp_balance += lp_share

                    logging.debug(f"LP balance for {account_address}: {lp_balance}")
                except Exception as e:
                    logging.error(f"Error getting LP balance for {account_address}: {e}")
            
            total_balance = direct_balance + lp_balance
            logging.info(f"Account {account_address} balance: Direct={direct_balance}, LP={lp_balance}, Total={total_balance}")
            return total_balance

        except Exception as e:
            logging.error(f"Error getting balance for {account_address}: {str(e)}")
            return Decimal('0')
    
    def get_stewardship_balances(self):
        """
        Get detailed balance information for each stewardship account.
        Important: This should return direct balances only to avoid double counting
        with liquidity pools.
        
        Returns:
            dict: Information about each stewardship account's balance and total
        """
        balances = []
        total_direct_balance = Decimal('0')
        
        # Get balances for each stewardship account (direct balance only)
        for i, address in enumerate(self.accounts['stewardship']):
            account_label = ["Management", "Infrastructure", "Liquidity"][i] if i < 3 else f"Account {i}"
            # Get direct balance only (no LP to avoid double counting)
            balance = self.get_account_balance(address, include_lp=False)
            balances.append({
                'index': i,
                'address': address,
                'label': account_label,
                'balance': balance
            })
            total_direct_balance += balance
            
        # Sort by balance (highest first)
        balances.sort(key=lambda x: x['balance'], reverse=True)
        
        # Log detailed stewardship account information
        for acct in balances:
            percent = (acct['balance'] / total_direct_balance * 100) if total_direct_balance > 0 else 0
            logging.info(f"Stewardship {acct['label']} Account ({acct['address']}): {acct['balance']} UBEC ({percent:.2f}%)")
        
        return {
            'accounts': balances,
            'total_direct': total_direct_balance
        }
    
    def get_liquidity_pool_balances(self):
        """
        Get detailed information about UBEC tokens in liquidity pools from database.
        This should be treated as a separate category from direct holdings.
        
        Returns:
            dict: Information about UBEC in liquidity pools
        """
        logging.info("Calculating UBEC tokens in liquidity pools...")
        
        try:
            # Query liquidity pools from database
            query = """
            SELECT id, pair, balance, source 
            FROM liquidity_pools 
            WHERE asset_code = %s AND asset_issuer = %s
            """
            pool_records = self.db.execute_query(query, [self.ubec_code, self.ubec_issuer])
            
            if pool_records:
                liquidity_pools = {}
                total_in_pools = Decimal('0')
                
                # Process each pool record
                for record in pool_records:
                    pool_id = record['id']
                    balance = Decimal(record['balance'])
                    total_in_pools += balance
                    
                    liquidity_pools[pool_id] = {
                        "id": pool_id,
                        "pair": record['pair'],
                        "balance": str(balance),
                        "source": record.get('source', 'database')
                    }
                
                logging.info(f"Found {len(liquidity_pools)} liquidity pools in database with {total_in_pools} total UBEC")
                return {
                    "pools": liquidity_pools,
                    "total": str(total_in_pools)
                }
            else:
                logging.info("No liquidity pools found in database")
                return {
                    "pools": {},
                    "total": "0"
                }
        except Exception as e:
            logging.error(f"Database error getting liquidity pools: {e}")
            return {
                "pools": {},
                "total": "0"
            }
    
    def get_all_ubec_holders(self):
        """
        Get a list of all accounts holding UBEC tokens from database.
        
        Returns:
            list: Information about all accounts holding UBEC tokens
        """
        logging.info("Retrieving all UBEC token holders...")
        
        try:
            # Query all holders from database
            query = """
            SELECT account_id, balance, 
                   classification AS type
            FROM asset_holders 
            WHERE asset_code = %s AND asset_issuer = %s AND balance > 0
            """
            holders = self.db.execute_query(query, [self.ubec_code, self.ubec_issuer])
            
            if holders:
                all_holders = []
                for holder in holders:
                    all_holders.append({
                        "account": holder['account_id'],
                        "balance": str(holder['balance']),
                        "type": holder['type']
                    })
                logging.info(f"Retrieved {len(all_holders)} UBEC holders from database")
                return all_holders
            else:
                logging.info("No holders found in database")
                return []
        except Exception as e:
            logging.error(f"Database error getting all holders: {e}")
            return []
    
    def run_holonic_evaluation(self):
        """
        Run holonic evaluation on UBEC holders using the Holonic Evaluator.
        
        Returns:
            dict: Holonic evaluation results
        """
        if not self.include_holonic or not self.holonic_evaluator:
            logging.warning("Holonic evaluation not enabled or evaluator not available")
            return {"status": "skipped", "reason": "Holonic evaluation not enabled"}
        
        try:
            logging.info("Running holonic evaluation for UBEC holders")
            
            # Use the holonic evaluator to run evaluation
            evaluation_report = self.holonic_evaluator.run_evaluation()
            
            # Extract key metrics for the audit report
            holonic_metrics = {
                "status": evaluation_report.get("status", "success"),
                "evaluated_count": evaluation_report.get("evaluated_count", 0),
                "evaluation_date": evaluation_report.get("evaluation_date", datetime.now().isoformat()),
                "average_scores": evaluation_report.get("average_scores", {}),
                "category_distribution": evaluation_report.get("category_distribution", {}),
                "recommendations": evaluation_report.get("recommendations", {})
            }
            
            # Store the full evaluation results in the audit report
            self.audit_report["holonic_metrics"] = holonic_metrics
            self.audit_report["holonic_evaluation"] = evaluation_report
            
            logging.info(f"Holonic evaluation completed for {holonic_metrics['evaluated_count']} accounts")
            
            return evaluation_report
            
        except Exception as e:
            logging.error(f"Error running holonic evaluation: {e}")
            self.audit_report["holonic_metrics"] = {
                "status": "error",
                "error": str(e)
            }
            return {"status": "error", "error": str(e)}
    
    def save_ubec_account_lists(self, output_dir=None):
        """
        Save various lists of accounts holding UBEC tokens to files.
        
        Args:
            output_dir: Directory to save the account list files
        
        Returns:
            dict: Paths to the saved files
        """
        # If no output_dir specified, use the current report directory
        if output_dir is None:
            output_dir = self.current_report_dir

        logging.info(f"Generating UBEC account lists in {output_dir}...")
        
        # Get all UBEC holders
        all_holders = self.get_all_ubec_holders()
        
        # Create output directory if it doesn't exist
        os.makedirs(output_dir, exist_ok=True)
        
        # Don't use timestamp here - it's already in the folder name
        output_files = {}
        
        # 1. Save all UBEC holder accounts
        all_accounts_file = os.path.join(output_dir, "ubec_all_accounts.csv")
        with open(all_accounts_file, 'w') as f:
            f.write("account,balance,type\n")
            for holder in all_holders:
                f.write(f"{holder['account']},{holder['balance']},{holder['type']}\n")
        
        output_files["all_accounts"] = all_accounts_file
        logging.info(f"Saved {len(all_holders)} UBEC holder accounts to {all_accounts_file}")
        
        # 2. Save accounts by type
        account_types = {}
        
        for holder in all_holders:
            account_type = holder.get('type', 'unknown')
            if account_type not in account_types:
                account_types[account_type] = []
            account_types[account_type].append(holder)
        
        for account_type, holders in account_types.items():
            type_file = os.path.join(output_dir, f"ubec_accounts_{account_type}.csv")
            with open(type_file, 'w') as f:
                f.write("account,balance,type\n")
                for holder in holders:
                    f.write(f"{holder['account']},{holder['balance']},{holder['type']}\n")
            
            output_files[f"accounts_{account_type}"] = type_file
            logging.info(f"Saved {len(holders)} {account_type} accounts to {type_file}")
        
        # 3. Save liquidity pool accounts
        liquidity_pools = self.audit_report.get("liquidity_pools", {}).get("pools", {})
        lp_accounts_file = os.path.join(output_dir, "ubec_liquidity_pool_accounts.csv")
        
        with open(lp_accounts_file, 'w') as f:
            f.write("pool_id,pair,balance,source\n")
            for pool_id, pool_data in liquidity_pools.items():
                pair = pool_data.get('pair', '')
                balance = pool_data.get('balance', '0')
                source = pool_data.get('source', 'unknown')
                f.write(f"{pool_id},{pair},{balance},{source}\n")
        
        output_files["liquidity_pool_accounts"] = lp_accounts_file
        logging.info(f"Saved {len(liquidity_pools)} liquidity pool accounts to {lp_accounts_file}")
        
        # 4. Save accounts by balance range
        balance_ranges = {
            "0-10": [],
            "10-100": [],
            "100-1000": [],
            "1000-10000": [],
            "10000-100000": [],
            "100000-1000000": [],
            "1000000+": []
        }
        
        for holder in all_holders:
            balance = Decimal(holder['balance'])
            
            if balance <= 10:
                balance_ranges["0-10"].append(holder)
            elif balance <= 100:
                balance_ranges["10-100"].append(holder)
            elif balance <= 1000:
                balance_ranges["100-1000"].append(holder)
            elif balance <= 10000:
                balance_ranges["1000-10000"].append(holder)
            elif balance <= 100000:
                balance_ranges["10000-100000"].append(holder)
            elif balance <= 1000000:
                balance_ranges["100000-1000000"].append(holder)
            else:
                balance_ranges["1000000+"].append(holder)
        
        for balance_range, holders in balance_ranges.items():
            if holders:  # Only save non-empty ranges
                range_file = os.path.join(output_dir, f"ubec_accounts_range_{balance_range}.csv")
                with open(range_file, 'w') as f:
                    f.write("account,balance,type\n")
                    for holder in holders:
                        f.write(f"{holder['account']},{holder['balance']},{holder['type']}\n")
                
                output_files[f"accounts_range_{balance_range}"] = range_file
                logging.info(f"Saved {len(holders)} accounts with balance {balance_range} UBEC to {range_file}")
        
        # 5. Save holonic categories if available
        if self.include_holonic and 'holonic_evaluation' in self.audit_report:
            holonic_categories = {}
            
            # Extract accounts by holonic category
            for result in self.audit_report.get('holonic_evaluation', {}).get('results', []):
                category = result.get('category', 'Unknown')
                if category not in holonic_categories:
                    holonic_categories[category] = []
                
                holonic_categories[category].append({
                    "account": result.get('public_key', result.get('account_id', '')),
                    "balance": "",  # Balance info not directly available in holonic results
                    "type": "holonic_" + category.lower(),
                    "holonic_score": result.get('composite_score', 0)
                })
            
            # Save each category to a separate file
            for category, holders in holonic_categories.items():
                if holders:
                    category_file = os.path.join(output_dir, f"ubec_holonic_{category.lower()}.csv")
                    with open(category_file, 'w') as f:
                        f.write("account,holonic_score,type\n")
                        for holder in holders:
                            f.write(f"{holder['account']},{holder['holonic_score']},{holder['type']}\n")
                    
                    output_files[f"holonic_{category.lower()}"] = category_file
                    logging.info(f"Saved {len(holders)} accounts in holonic category {category} to {category_file}")
        
        # 6. Save a combined JSON file with all information
        all_data = {
            "timestamp": datetime.now().isoformat(),
            "all_accounts": [dict(holder) for holder in all_holders],
            "account_types": {k: [dict(h) for h in v] for k, v in account_types.items()},
            "liquidity_pools": liquidity_pools,
            "balance_ranges": {k: [dict(h) for h in v] for k, v in balance_ranges.items() if v},
            "target_distribution": {
                "stewardship": str(Decimal(self.target_distribution['stewardship'])),
                "administration": str(Decimal(self.target_distribution['administration']))
            }
        }
        
        # Add holonic data if available
        if self.include_holonic and 'holonic_metrics' in self.audit_report:
            all_data["holonic_metrics"] = self.audit_report["holonic_metrics"]
            
            # If we have holonic evaluation results, add them
            if 'holonic_evaluation' in self.audit_report:
                if 'holonic_categories' in locals():
                    all_data["holonic_categories"] = {
                        category: [dict(h) for h in holders]
                        for category, holders in holonic_categories.items()
                    }
                
                # Add holonic evaluation summary
                all_data["holonic_evaluation_summary"] = {
                    "total_evaluated": self.audit_report.get('holonic_evaluation', {}).get('evaluated_count', 0),
                    "category_distribution": self.audit_report.get('holonic_evaluation', {}).get('category_distribution', {}),
                    "average_scores": self.audit_report.get('holonic_evaluation', {}).get('average_scores', {})
                }
        
        json_file = os.path.join(output_dir, "ubec_accounts_complete.json")
        with open(json_file, 'w') as f:
            json.dump(all_data, f, indent=2)
        
        output_files["complete_json"] = json_file
        logging.info(f"Saved complete account information to {json_file}")
        
        # 7. Create a summary file with key statistics
        summary_file = os.path.join(output_dir, "ubec_accounts_summary.txt")
        with open(summary_file, 'w') as f:
            f.write("UBEC TOKEN HOLDER SUMMARY\n")
            f.write("========================\n\n")
            f.write(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
            
            f.write(f"Total UBEC holders: {len(all_holders)}\n")
            f.write(f"Total UBEC supply: {self.total_supply}\n")
            
            f.write("\nAccount Type Distribution:\n")
            for account_type, holders in account_types.items():
                f.write(f"  {account_type}: {len(holders)} accounts\n")
            
            f.write("\nBalance Range Distribution:\n")
            for balance_range, holders in balance_ranges.items():
                if holders:
                    f.write(f"  {balance_range} UBEC: {len(holders)} accounts\n")
            
            f.write(f"\nLiquidity Pools: {len(liquidity_pools)}\n")
            f.write(f"Total UBEC in Liquidity Pools: {self.audit_report.get('liquidity_pools', {}).get('total', '0')}\n")
            
            if self.include_holonic and 'holonic_metrics' in self.audit_report:
                f.write("\nHolonic Evaluation Summary:\n")
                if 'holonic_evaluation' in self.audit_report:
                    eval_data = self.audit_report.get('holonic_evaluation', {})
                    f.write(f"  Total Evaluated: {eval_data.get('evaluated_count', 0)}\n")
                    
                    category_dist = eval_data.get('category_distribution', {})
                    if category_dist:
                        f.write("\n  Category Distribution:\n")
                        for category, count in category_dist.items():
                            f.write(f"    {category}: {count} accounts\n")
                    
                    avg_scores = eval_data.get('average_scores', {})
                    if avg_scores:
                        f.write("\n  Average Holonic Scores:\n")
                        for metric, score in avg_scores.items():
                            f.write(f"    {metric}: {score:.4f}\n")
                else:
                    f.write(f"  Status: {self.audit_report.get('holonic_metrics', {}).get('status', 'Not Run')}\n")
        
        output_files["summary"] = summary_file
        logging.info(f"Saved summary to {summary_file}")
        
        # 8. Save a README file for this report
        readme_file = os.path.join(output_dir, "AUDIT_README.txt")
        with open(readme_file, 'w') as f:
            f.write("UBEC TOKEN AUDIT REPORT\n")
            f.write("======================\n\n")
            f.write(f"Audit Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"Report Directory: {os.path.basename(output_dir)}\n\n")
            
            f.write("FILES IN THIS REPORT:\n")
            f.write("--------------------\n")
            for key, filepath in output_files.items():
                filename = os.path.basename(filepath)
                f.write(f"  {filename} - {key.replace('_', ' ').title()}\n")
            
            f.write("\nDESCRIPTION:\n")
            f.write("------------\n")
            f.write("This directory contains a comprehensive audit of UBEC token distribution\n")
            f.write("including account lists, balance distributions, liquidity pool information,\n")
            f.write("and (if enabled) holonic evaluation metrics.\n\n")
            
            f.write("For questions about this report, please contact the UBEC team.\n")
        
        output_files["readme"] = readme_file
        
        return output_files
    
    def perform_audit(self):
        """
        Perform a comprehensive audit of UBEC token distribution.

        Returns:
            dict: The audit report
        """
        logging.info("Starting UBEC token audit...")

        # Create report directory for this audit
        os.makedirs(self.current_report_dir, exist_ok=True)
        
        # Always use database data
        general_balance = self.get_account_balance(self.accounts['general'], include_lp=False)
        admin_balance = self.get_account_balance(self.accounts['administration'], include_lp=False)

        # Get stewardship balances (direct balances only)
        stewardship_data = self.get_stewardship_balances()
        stewardship_balance = stewardship_data['total_direct']
        
        self.audit_report["accounts"]["stewardship"] = {}
        for acct in stewardship_data['accounts']:
            self.audit_report["accounts"]["stewardship"][acct['address']] = {
                "label": acct['label'],
                "balance": str(acct['balance'])
            }
        
        # Get liquidity pool balances separately
        liquidity_pools = self.get_liquidity_pool_balances()
        self.audit_report["liquidity_pools"] = liquidity_pools
        
        # Total stewardship is direct holdings only - LPs are already included in the liquidity account
        total_stewardship_balance = stewardship_balance
        
        # Add account balances to the report
        self.audit_report["accounts"]["general"] = {
            "address": self.accounts['general'],
            "balance": str(general_balance)
        }
        
        self.audit_report["accounts"]["administration"] = {
            "address": self.accounts['administration'],
            "balance": str(admin_balance)
        }
        
        self.audit_report["accounts"]["stewardship"]["total_direct"] = str(stewardship_balance)
        self.audit_report["accounts"]["stewardship"]["total_with_pools"] = str(total_stewardship_balance)
        
        # Get total LP balance
        lp_total = Decimal(liquidity_pools["total"])
        
        # Calculate total monitored balance (liquidity pools are already counted in stewardship)
        # The liquidity pools ARE the stewardship liquidity account balance
        total_monitored = general_balance + admin_balance + stewardship_balance
        # Don't add lp_total again as it's already included in stewardship_balance
        
        self.audit_report["total_monitored"] = str(total_monitored)
        
        # Calculate untracked supply
        untracked_supply = self.total_supply - total_monitored
        self.audit_report["untracked_supply"] = str(untracked_supply)
        self.audit_report["untracked_percentage"] = str(untracked_supply / self.total_supply if self.total_supply > 0 else 0)
        
        # Calculate current distribution percentages (of monitored supply)
        if total_monitored > 0:
            distribution = {
                'general': str(general_balance / total_monitored),
                'administration': str(admin_balance / total_monitored),
                'stewardship': str(stewardship_balance / total_monitored)
            }
        else:
            distribution = {
                'general': "0",
                'administration': "0",
                'stewardship': "0"
            }
        self.audit_report["distribution"]["current"] = distribution
        
        # Calculate current percentage against total supply for compliance check
        admin_pct_of_supply = admin_balance / self.total_supply if self.total_supply > 0 else 0
        steward_pct_of_supply = stewardship_balance / self.total_supply if self.total_supply > 0 else 0
        
        self.audit_report["distribution"]["of_total_supply"] = {
            'administration': str(admin_pct_of_supply),
            'stewardship': str(steward_pct_of_supply)
        }
        
        # Add target distribution for comparison
        target_dist = {}
        for key, value in self.target_distribution.items():
            target_dist[key] = str(value)
        self.audit_report["distribution"]["target"] = target_dist
        
        # Calculate target values based on the total supply
        target_values = {
            'administration': self.total_supply * Decimal(self.target_distribution['administration']),
            'stewardship': self.total_supply * Decimal(self.target_distribution['stewardship'])
        }
        target_values['general'] = self.total_supply - target_values['administration'] - target_values['stewardship']
        
        # Store target values in the report as strings
        self.audit_report["target_values"] = {
            'total_supply': str(self.total_supply),
            'administration': str(target_values['administration']),
            'stewardship': str(target_values['stewardship']),
            'general': str(target_values['general'])
        }
        
        # Calculate deviations from target for administration and stewardship only
        deviations = {
            'administration': str(admin_pct_of_supply - Decimal(target_dist['administration'])),
            'stewardship': str(steward_pct_of_supply - Decimal(target_dist['stewardship']))
        }
        self.audit_report["distribution"]["deviations"] = deviations
        
        # Check tokenomics compliance
        threshold = Decimal('0.01')  # 1% threshold
        compliance = {
            'administration': abs(Decimal(deviations['administration'])) <= threshold,
            'stewardship': abs(Decimal(deviations['stewardship'])) <= threshold
        }
        overall_compliance = all(compliance.values())
        
        self.audit_report["tokenomics_compliance"]["per_category"] = compliance
        self.audit_report["tokenomics_compliance"]["overall"] = overall_compliance
        
        # Add comparison against target values
        current_values = {
            'administration': admin_balance,
            'stewardship': stewardship_balance
        }
        
        differences = {}
        for category in ['administration', 'stewardship']:
            target = target_values[category]
            current = current_values[category]
            difference = current - target
            difference_pct = (difference / target) * 100 if target > 0 else 0
            
            differences[category] = {
                "target": str(target),
                "current": str(current),
                "difference": str(difference),
                "difference_percentage": str(difference_pct)
            }
        
        self.audit_report["target_comparison"] = differences
        
        # Get information about all UBEC holders
        all_holders = self.get_all_ubec_holders()
        self.audit_report["all_holders_count"] = len(all_holders)
        
        # Run holonic evaluation if enabled
        if self.include_holonic:
            self.run_holonic_evaluation()
        
        # Store the audit results in the database
        try:
            self._store_audit_results()
        except Exception as e:
            logging.error(f"Error storing audit results in database: {e}")
        
        # Save the complete audit report to the report directory
        report_file = os.path.join(self.current_report_dir, "audit_report.json")
        with open(report_file, 'w') as f:
            json.dump(self.audit_report, f, indent=2)
        logging.info(f"Saved audit report to {report_file}")
        
        # For logging purposes - convert to percentages
        gen_pct = float(Decimal(distribution['general']) * 100)
        admin_pct = float(admin_pct_of_supply * 100)
        stew_pct = float(steward_pct_of_supply * 100)
        monitor_pct = float(total_monitored / self.total_supply * 100) if self.total_supply > 0 else 0
        
        # Log a summary of the audit
        logging.info(f"Audit completed - Tokenomics compliance: {overall_compliance}")
        logging.info(f"Total monitored: {total_monitored} ({monitor_pct:.2f}% of total supply)")
        logging.info(f"Distribution of monitored funds: General={gen_pct:.2f}%, Admin={admin_pct:.2f}%, Stewardship={stew_pct:.2f}%")
        logging.info(f"Distribution of total supply: Admin={admin_pct:.2f}%, Stewardship={stew_pct:.2f}%")
        logging.info(f"Target: Admin=5.00%, Stewardship=30.00%")
        
        # Log specific category details
        for category in ['administration', 'stewardship']:
            current = current_values[category]
            target = target_values[category]
            diff_pct = float((current - target) / target * 100 if target > 0 else 0)
            logging.info(f"{category.capitalize()}: Current={current}, Target={target}, Difference={diff_pct:.2f}%")
        
        return self.audit_report
    
    def _store_audit_results(self):
        """
        Store audit results in the database for historical tracking.
        """
        try:
            # Create an asset holder analysis record
            query = """
            INSERT INTO asset_holder_analysis (
                analysis_date, asset_code, asset_issuer, 
                total_holders, total_supply, active_holders, 
                new_holders_last_30_days, whale_concentration_percent, 
                gini_coefficient, distribution_metrics
            ) VALUES (
                NOW(), %s, %s, %s, %s, %s, %s, %s, %s, %s
            )
            """
            
            # Extract metrics from the audit report
            total_holders = self.audit_report.get("all_holders_count", 0)
            
            # Get basic metrics
            active_holders = total_holders  # Assume all holders are active
            new_holders = 0  # We don't track this yet
            
            # Calculate whale concentration (simplified)
            whale_percentage = 0
            if "target_comparison" in self.audit_report:
                # Use stewardship percentage as an approximation
                stewardship_pct = Decimal(self.audit_report["distribution"]["of_total_supply"]["stewardship"])
                whale_percentage = float(stewardship_pct * 100)
            
            # Create distribution metrics JSON
            distribution_metrics = {
                'general_balance': self.audit_report["accounts"]["general"]["balance"],
                'admin_balance': self.audit_report["accounts"]["administration"]["balance"],
                'stewardship_balance': self.audit_report["accounts"]["stewardship"]["total_with_pools"],
                'liquidity_pool_balance': self.audit_report["liquidity_pools"]["total"],
                'compliance': self.audit_report["tokenomics_compliance"]["overall"],
                'deviations': self.audit_report["distribution"]["deviations"]
            }
            
            # Add holonic metrics if available
            if 'holonic_metrics' in self.audit_report:
                distribution_metrics['holonic'] = self.audit_report["holonic_metrics"]
            
            # Execute the query
            self.db.execute_query(query, [
                self.ubec_code, 
                self.ubec_issuer,
                total_holders,
                str(self.total_supply),
                active_holders,
                new_holders,
                whale_percentage,
                0.5,  # Default Gini coefficient
                json.dumps(distribution_metrics)
            ])
            
            logging.info(f"Stored audit results in the database")
            
            # Also try to store in a more detailed audit_reports table if it exists
            try:
                detail_query = """
                INSERT INTO audit_reports (
                    report_date, report_type, asset_code, asset_issuer, 
                    report_data, compliance_status
                ) VALUES (
                    NOW(), %s, %s, %s, %s, %s
                )
                """
                
                self.db.execute_query(detail_query, [
                    'token_distribution',
                    self.ubec_code,
                    self.ubec_issuer,
                    json.dumps(self.audit_report),
                    self.audit_report["tokenomics_compliance"]["overall"]
                ])
                
                logging.info("Stored detailed audit report in database")
            except Exception as e:
                # This is optional, so just log the error
                logging.warning(f"Could not store detailed audit report: {e}")
            
        except Exception as e:
            logging.error(f"Error storing audit results: {str(e)}")
            raise
    
    def add_transfer_recommendations(self):
        """
        Add transfer recommendations to the audit report based on the current distribution
        and the target values.
        """
        # Skip if compliance is already achieved
        if self.audit_report["tokenomics_compliance"]["overall"]:
            logging.info("Token distribution is already compliant, no transfers needed")
            return
        
        # Calculate needed transfers
        transfers = []
        
        # Get current values and target values
        target_values = {
            'administration': Decimal(self.audit_report["target_values"]["administration"]),
            'stewardship': Decimal(self.audit_report["target_values"]["stewardship"])
        }
        
        current_values = {
            'administration': Decimal(self.audit_report["accounts"]["administration"]["balance"]),
            'stewardship': Decimal(self.audit_report["accounts"]["stewardship"]["total_direct"])
        }
        
        # Calculate differences
        differences = {
            'administration': target_values['administration'] - current_values['administration'],
            'stewardship': target_values['stewardship'] - current_values['stewardship']
        }
        
        # Add recommendations for transfers from general to administration or stewardship
        for category, difference in differences.items():
            if difference > 0:  # Need to transfer to this category
                transfer = {
                    'from': 'general',
                    'to': category,
                    'amount': str(difference),
                    'reason': f'Adjust {category} balance to target percentage'
                }
                transfers.append(transfer)
        
        # Add transfers to the audit report
        self.audit_report["transfer_recommendations"] = {
            'transfers': transfers,
            'timestamp': datetime.now().isoformat()
        }
        
        # Save recommendations to the report directory
        recommendations_file = os.path.join(self.current_report_dir, "transfer_recommendations.json")
        with open(recommendations_file, 'w') as f:
            json.dump(self.audit_report["transfer_recommendations"], f, indent=2)
        logging.info(f"Saved transfer recommendations to {recommendations_file}")
        
        # Store transfer recommendations in the database if available
        if self.data_source != "stellar" and transfers:
            try:
                # Check if transfer_recommendations table exists
                check_query = """
                SELECT EXISTS (
                   SELECT FROM information_schema.tables 
                   WHERE table_schema = 'ubec_recipro'
                   AND table_name = 'transfer_recommendations'
                );
                """
                result = self.db.execute_query(check_query, fetch_one=True)
                
                if result and result.get('exists', False):
                    # Insert transfer recommendations
                    for transfer in transfers:
                        insert_query = """
                        INSERT INTO transfer_recommendations 
                        (recommendation_date, asset_code, asset_issuer, 
                         from_account_type, to_account_type, amount, status, priority) 
                        VALUES (NOW(), %s, %s, %s, %s, %s, %s, %s)
                        """
                        
                        self.db.execute_query(insert_query, [
                            self.ubec_code,
                            self.ubec_issuer,
                            transfer['from'],
                            transfer['to'],
                            transfer['amount'],
                            'pending',
                            1  # High priority
                        ])
                    
                    logging.info(f"Stored {len(transfers)} transfer recommendations in database")
            except Exception as e:
                logging.error(f"Error storing transfer recommendations: {e}")
