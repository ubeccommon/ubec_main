                framealpha=0.95,
                edgecolor=UBUNTU_COLORS['neutral']['grid']
            )
            
            ax.axis('off')
            plt.tight_layout()
            
            # Convert to base64
            buffer = BytesIO()
            plt.savefig(buffer, format='png', dpi=300, bbox_inches='tight')
            buffer.seek(0)
            image_base64 = base64.b64encode(buffer.read()).decode('utf-8')
            plt.close(fig)
            
            self._charts_generated += 1
