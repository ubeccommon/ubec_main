            font-weight: bold;
        }}
        
        .category-exemplar {{ background: #9333ea; }}
        .category-integrator {{ background: #10b981; }}
        .category-contributor {{ background: #3b82f6; }}
        .category-participant {{ background: #f59e0b; }}
        .category-observer {{ background: #6b7280; }}
        
        .methodology {{
            background: #f8f9fa;
            padding: 25px;
            border-radius: 8px;
            margin: 20px 0;
        }}
        
        .methodology h4 {{
            color: #667eea;
            margin-bottom: 10px;
        }}
        
        .methodology ul {{
            margin-left: 20px;
        }}
        
        .methodology li {{
            margin: 8px 0;
        }}
        
        footer {{
            background: #2d3748;
            color: white;
            padding: 30px;
            text-align: center;
        }}
        
        footer p {{
            margin: 10px 0;
        }}
        
        .footer-emphasis {{
            font-weight: bold;
            color: #ffd700;
        }}
        
        .unavailable-notice {{
            background: #fef3c7;
            border-left: 5px solid #f59e0b;
            padding: 15px;
            margin: 20px 0;
            border-radius: 8px;
        }}
        
        .unavailable-notice p {{
            color: #92400e;
            margin: 5px 0;
        }}
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🌐 UBEC Holonic Evaluation Report</h1>
            <p>Comprehensive Analysis of Network Holonic Integration</p>
            <p>Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S UTC')}</p>
        </header>
        
        <div class="content">
            <!-- Executive Summary -->
            <section class="section">
                <h2>📊 Executive Summary</h2>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>Total Accounts</h3>
                        <div class="stat-value">{stats['total_accounts']}</div>
                        <div class="stat-label">Evaluated Accounts</div>
                    </div>
                    
                    <div class="stat-card">
                        <h3>Mean Score</h3>
                        <div class="stat-value">{stats['mean_score']:.4f}</div>
                        <div class="stat-label">Average Holonic Score</div>
                    </div>
                    
                    <div class="stat-card">
                        <h3>Median Score</h3>
                        <div class="stat-value">{stats['median_score']:.4f}</div>
                        <div class="stat-label">50th Percentile</div>
                    </div>
                    
                    <div class="stat-card">
                        <h3>Score Range</h3>
                        <div class="stat-value">{stats['min_score']:.3f} - {stats['max_score']:.3f}</div>
                        <div class="stat-label">Min - Max</div>
                    </div>
                </div>
                
                <h3>Category Distribution</h3>
                <div class="category-grid">"""
            
            # Add category badges
            category_order = ['Exemplar', 'Integrator', 'Contributor', 'Participant', 'Observer']
            for category in category_order:
                if category in categories:
                    count = len(categories[category])
                    pct = (count / stats['total_accounts']) * 100
                    css_class = f"category-{category.lower()}"
                    html_content += f"""
                    <div class="category-badge {css_class}">
                        <div>{category}</div>
                        <div style="font-size: 1.8em; margin: 10px 0;">{count}</div>
                        <div>{pct:.1f}%</div>
                    </div>"""
            
            html_content += f"""
                </div>
            </section>
            
            <!-- Key Insights -->
            <section class="section">
                <div class="insights-box">
                    <h3>🔍 Key Insights</h3>
                    <ul>
                        <li><strong>Dominant Category:</strong> {top_category} represents {top_category_pct:.1f}% of all evaluated accounts</li>
                        <li><strong>Score Distribution:</strong> 25th percentile = {percentiles['p25']:.4f}, 75th percentile = {percentiles['p75']:.4f}</li>
                        <li><strong>High Performers:</strong> {sum(1 for acc in self.report_data['accounts'] if acc['composite_score'] >= 0.8)} accounts ({(sum(1 for acc in self.report_data['accounts'] if acc['composite_score'] >= 0.8) / stats['total_accounts'] * 100):.1f}%) scored 0.8 or higher</li>
                        <li><strong>Network Maturity:</strong> Mean score of {stats['mean_score']:.4f} indicates {'strong' if stats['mean_score'] >= 0.6 else 'moderate' if stats['mean_score'] >= 0.4 else 'developing'} holonic integration</li>
                    </ul>
                </div>
            </section>
            
            <!-- Visualizations -->
            <section class="section">
                <h2>📈 Visualizations</h2>
                
                <h3>Score Distribution</h3>
                <div class="chart">"""
            
            if charts.get('score_dist'):
                html_content += f'<img src="data:image/png;base64,{charts["score_dist"]}" alt="Score Distribution">'
            
            html_content += """
                </div>
                
                <h3>Category Distribution</h3>
                <div class="chart">"""
            
            if charts.get('category_dist'):
                html_content += f'<img src="data:image/png;base64,{charts["category_dist"]}" alt="Category Distribution">'
            
            html_content += """
                </div>
                
                <h3>Top Performers - Holonic Dimensions</h3>
                <div class="chart">"""
            
            if charts.get('radar'):
                html_content += f'<img src="data:image/png;base64,{charts["radar"]}" alt="Radar Chart">'
            
            html_content += """
                </div>
                
                <h3>Dimension Correlation Matrix</h3>
                <div class="chart">"""
            
            if charts.get('correlation'):
                html_content += f'<img src="data:image/png;base64,{charts["correlation"]}" alt="Correlation Matrix">'
            
            html_content += """
                </div>
                
                <h3>Score Trends Over Time</h3>
                <div class="chart">"""
            
            if charts.get('time_series'):
                html_content += f'<img src="data:image/png;base64,{charts["time_series"]}" alt="Time Series">'
            
            html_content += """
                </div>"""
            
            # Add advanced charts if included
            if include_advanced:
                html_content += """
                <h3>Comparative Category Analysis</h3>
                <div class="chart">"""
                
                if charts.get('comparative'):
                    html_content += f'<img src="data:image/png;base64,{charts["comparative"]}" alt="Comparative Analysis">'
                
                html_content += """
                </div>
                
                <h3>Transaction Network</h3>"""
                
                if charts.get('network'):
                    html_content += '<div class="chart">'
                    html_content += f'<img src="data:image/png;base64,{charts["network"]}" alt="Transaction Network">'
                    html_content += '</div>'
                elif not self.transactions_table_available:
                    html_content += """
                <div class="unavailable-notice">
                    <p><strong>ℹ️ Feature Unavailable:</strong></p>
                    <p>Transaction network visualization requires the 'transactions' table in the database schema.</p>
                    <p>This table is not currently present. The network visualization feature is optional and will be enabled automatically when the table becomes available.</p>
                </div>"""
            
            html_content += f"""
            </section>
            
            <!-- Methodology -->
            <section class="section">
                <h2>📚 Methodology</h2>
                
                <div class="methodology">
                    <h4>Holonic Evaluation Framework</h4>
                    <p>
                        The UBEC holonic evaluation system assesses accounts across five key dimensions, 
                        each measuring a critical aspect of holonic (whole-part) integration:
                    </p>
                    <ul>
                        <li><strong>Autonomy:</strong> Self-governance and decision-making capability</li>
                        <li><strong>Cooperation:</strong> Collaborative engagement and mutual support</li>
                        <li><strong>Transcendence:</strong> Contribution to larger system goals</li>
                        <li><strong>Regeneration:</strong> Sustainable value creation and resource renewal</li>
                        <li><strong>Resilience:</strong> Adaptability and recovery capacity</li>
                    </ul>
                    <p>
                        <strong>Scoring Methodology:</strong> Each dimension is scored from 0.0 to 1.0 using on-chain data analysis and pattern recognition. The composite score is a weighted average of all five dimensions, providing a holistic assessment of an account's holonic maturity.
                    </p>
                    <p>
                        <strong>Category Classifications:</strong> Accounts are categorized based on their composite score:
                    </p>
                    <ul>
                        <li><strong>Exemplar</strong> (0.8 - 1.0): Demonstrates exceptional holonic integration across all dimensions</li>
                        <li><strong>Integrator</strong> (0.6 - 0.8): Shows strong holonic characteristics with room for growth</li>
                        <li><strong>Contributor</strong> (0.4 - 0.6): Actively participates with moderate holonic alignment</li>
                        <li><strong>Participant</strong> (0.2 - 0.4): Engaged but developing holonic capabilities</li>
                        <li><strong>Observer</strong> (0.0 - 0.2): Early-stage or minimal network participation</li>
                    </ul>
                </div>
            </section>
        </div>
        
        <footer>
            <p class="footer-emphasis">
                This project uses the services of Claude and Anthropic PBC to inform our 
                decisions and recommendations.
            </p>
            <p>
                This project was made possible with the assistance of 
                <span class="footer-emphasis">Claude and Anthropic PBC</span>.
            </p>
            <p style="margin-top: 20px; opacity: 0.8;">
                © {datetime.now().year} UBEC Protocol Team | Version 12.1.2 | Holonic Visualization Service
            </p>
            <p style="opacity: 0.8;">
                All holonic evaluations are based on on-chain data and computed using 
                advanced metrics aligned with ubuntu philosophy and regenerative economics.
            </p>
        </footer>
    </div>
</body>
</html>"""
            
            # Save HTML report
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            report_filename = f'ubec_holonic_report_{timestamp}.html'
            report_path = output_path / report_filename
            
            with open(report_path, 'w', encoding='utf-8') as f:
                f.write(html_content)
            
            self.logger.info(f"HTML report generated: {report_path}")
            
            return str(report_path)
            
        except Exception as e:
            self.logger.error(f"Error generating HTML report: {e}", exc_info=True)
            return None
    
    async def close(self):
        """
        Clean up visualizer resources.
        
        Note: Does not close the database pool as it's managed by the service registry.
        """
        try:
            # Close any matplotlib figures
            plt.close('all')
            
            # Clear cached data
            self.report_data = None
            self.time_series_data = None
            
            self.logger.info("HolonicVisualizer closed successfully")
            
        except Exception as e:
            self.logger.error(f"Error closing visualizer: {e}", exc_info=True)


# ═════════════════════════════════════════════════════════════════════════════
# Factory Function (Service Registry Integration)
# ═════════════════════════════════════════════════════════════════════════════

async def create_holonic_visualizer(
    db_manager: Any,
    config: Dict[str, Any],
    logger: Optional[logging.Logger] = None
) -> HolonicVisualizer:
    """
    Factory function to create and initialize HolonicVisualizer service.
    
    This is the ONLY way to instantiate the visualizer service, enforcing
    the service pattern and ensuring proper initialization.
    
    Args:
        db_manager: Async database manager instance (from service registry)
        config: Configuration dictionary
        logger: Optional logger instance
        
    Returns:
        Initialized HolonicVisualizer instance
        
    Raises:
        RuntimeError: If initialization fails
    """
    visualizer = HolonicVisualizer(
        db_manager=db_manager,
        config=config,
        logger=logger
    )
    
    success = await visualizer.initialize()
    
    if not success:
        raise RuntimeError("Failed to initialize HolonicVisualizer service")
    
    return visualizer


# ═════════════════════════════════════════════════════════════════════════════
# Module Documentation
# ═════════════════════════════════════════════════════════════════════════════

__all__ = ['HolonicVisualizer', 'create_holonic_visualizer']

"""
UBEC Holonic Visualizer Service - Usage Examples
═════════════════════════════════════════════════════════════════════════════

Basic Usage (via Service Registry):
───────────────────────────────────────────────────────────────────────────────
    # Get service from registry
    visualizer = registry.get_service('holonic_visualizer')
    
    # Generate comprehensive HTML report (via wrapper)
    report_path = await visualizer.generate_report(
        format='html',
        output_dir='./reports',
        include_advanced=True
    )
    
    # Or use direct method
    report_path = await visualizer.generate_html_report('./reports')
    
    # Generate all charts separately
    charts = await visualizer.generate_all('./visualizations')

Individual Chart Generation:
───────────────────────────────────────────────────────────────────────────────
    # Using wrapper method (main.py compatible)
    chart = await visualizer.generate_chart('score_dist', './charts')
    chart = await visualizer.generate_chart('radar', './charts')
    chart = await visualizer.generate_chart('network', './charts')
    
    # Or use direct methods
    score_chart = await visualizer.create_score_distribution_chart()
    category_chart = await visualizer.create_category_distribution_chart()
    
    # Comparative category analysis
    comparative_chart = await visualizer.create_comparative_category_analysis()
    
    # Transaction network visualization (if available)
    if visualizer.transactions_table_available:
        network_chart = await visualizer.create_transaction_network_visualization()
    else:
        print("Transaction network feature not available")
    
    # Radar chart (top performers)
    radar_chart = await visualizer.create_radar_chart(top_n=10)
    
    # Time-series trends
    time_chart = await visualizer.create_time_series_chart(days=30)
    
    # Correlation matrix
    corr_chart = await visualizer.create_correlation_matrix()

Health Check:
───────────────────────────────────────────────────────────────────────────────
    # Check service health
    health = await visualizer.health_check()
    print(f"Service healthy: {health['healthy']}")
    print(f"Charts generated: {health['statistics']['charts_generated']}")
    print(f"Transactions available: {health['transactions_available']}")

Data Loading:
───────────────────────────────────────────────────────────────────────────────
    # Load evaluation data with optional limit
    data = await visualizer.load_evaluation_data(limit=100)
    
    # Access loaded data
    print(f"Accounts: {len(data['accounts'])}")
    print(f"Categories: {data['categories']}")
    print(f"Statistics: {data['statistics']}")

Design Principles Adherence:
───────────────────────────────────────────────────────────────────────────────
✅ #1  Modular: Self-contained visualization logic
✅ #2  Service Pattern: Factory-based instantiation only
✅ #3  Registry: Integrated with service registry
✅ #4  Single Source: Database is authoritative
✅ #5  Async: All I/O operations use async/await
✅ #6  No Fallbacks: Explicit feature detection, no exception-based flow
✅ #7  Per-Asset: Individual account tracking
✅ #8  No Duplication: Centralized configuration
✅ #9  Rate Limiting: Built-in database throttling
✅ #10 Separation: Visualization logic isolated
✅ #11 Documentation: Comprehensive docstrings
✅ #12 Singularity: Each method implemented once

Attribution:
───────────────────────────────────────────────────────────────────────────────
This project uses the services of Claude and Anthropic PBC to inform our
decisions and recommendations. This project was made possible with the
assistance of Claude and Anthropic PBC.
═════════════════════════════════════════════════════════════════════════════
"""
